{
  "version": "taigu_step4_multilog_v2",
  "step2_output_dir": "太古界/step2_well_log_segments/output/taigu_step2_multilog_v1",
  "step3_output_dir": "太古界/step3_imaging_groups/output/taigu_step3_imaging_multilog_v2",
  "use_multilog_conventional_curves": true,
  "data_layout": {
    "main_tables": "depth/curves/predictions/window semantics only",
    "provenance_tables": "source segment ids, merge rules and support ranges",
    "source_fields_in_model": false
  },
  "feature_contract": {
    "base_curves": [
      "GR",
      "AC",
      "CNL",
      "DEN",
      "RDeep",
      "RReference"
    ],
    "require_all_curves": true,
    "source_fields_in_model": false,
    "standardization": "well_strata_robust_z_and_rank",
    "cross_features": [
      "AC_CNL_Separation",
      "AC_DEN_Separation",
      "CNL_DEN_Separation",
      "GRxACResidual",
      "GRxCNLResidual",
      "GRxDensityResidual"
    ]
  },
  "strata": [
    "上部复合层",
    "太古界风化壳"
  ],
  "point_wells": [
    "埕北313",
    "桩斜169",
    "埕北古斜405",
    "埕北310",
    "埕北816"
  ],
  "density_only_wells": [
    "桩海102"
  ],
  "max_support_gap_m": 0.5,
  "merge": {
    "tolerance_m": 0.25,
    "gap_break_m": 0.5,
    "weight_scheme": "equal",
    "rule": "select",
    "select_priority": [
      "log_date_desc",
      "segment_rows_desc",
      "segment_id_asc"
    ]
  },
  "supervision_gate": {
    "positive_tiers": [
      "strong",
      "presence_only"
    ],
    "negative_tiers": [
      "strong",
      "presence_only"
    ],
    "density_regression_tiers": [
      "strong",
      "presence_only"
    ],
    "calibration_wells": [
      "埕北313",
      "埕北古斜405",
      "桩斜169",
      "埕北816"
    ]
  },
  "refine": {
    "gap_break_m": 0.5,
    "min_interval_thickness_m": 1.0,
    "coverage_targets": {
      "上部复合层": 0.33,
      "太古界风化壳": 0.68
    },
    "density_bins": [
      0.5,
      2.0
    ],
    "thickness_bins": [
      3.0,
      10.0
    ]
  },
  "label": {
    "clear_positive_density_quantile": 0.5,
    "clear_positive_point_radius_m": 0.5,
    "clear_background_density_max": 0.0,
    "clear_background_point_exclusion_m": 0.75
  },
  "threshold_strategy": "match_oof_prevalence",
  "random_state": 42,
  "xgb_n_jobs": 2,
  "stage1_params": {
    "n_estimators": 300,
    "max_depth": 3,
    "learning_rate": 0.05,
    "min_child_weight": 8,
    "subsample": 0.85,
    "colsample_bytree": 0.85,
    "reg_alpha": 0.2,
    "reg_lambda": 2.0
  },
  "stage2_params": {
    "n_estimators": 300,
    "max_depth": 3,
    "learning_rate": 0.05,
    "min_child_weight": 6,
    "subsample": 0.85,
    "colsample_bytree": 0.85,
    "reg_alpha": 0.1,
    "reg_lambda": 2.0
  },
  "output_dir": "太古界/step4_fracture_prediction/output/taigu_step4_multilog_v2",
  "feature_windows": {
    "scope": "segment",
    "cross_segment_max_window_m": 0.0
  },
  "_note": "主表仅保存逐行数据与预测；来源曲线、来源段和合并规则进入独立 provenance 表。"
}
